    "test:watch": "vitest",
    "qa:visual": "node scripts/qa-visual.mjs",
    "demo:reset": "node scripts/demo-reset.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/mada": "5.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "jsdom": "29.1.1",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
