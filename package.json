  "version": "0.2.0",
  "description": "VPS Panel — infrastructure console concept for VPS and RDP fleets. Client-side only, seeded demo data.",
  "author": "Fedaa Mohamed",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
